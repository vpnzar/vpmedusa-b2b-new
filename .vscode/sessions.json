{
    "theme": "tribe",
    "active": "medusa-dev",
    "activateOnStartup": true,
    "keepExistingTerminals": false,
    "sessions": {
        "medusa-dev": [
            {
                "name": "1. Docker (DB, Redis, Strapi)",
                "color": "terminal.ansiCyan",
                "icon": "container",
                "autoExecuteCommands": true,
                "commands": [
                    "docker-compose up -d medusa_db redis meilisearch strapi"
                ]
            },
            {
                "name": "2. Storefront Frontend",
                "color": "terminal.ansiMagenta",
                "icon": "browser",
                "autoExecuteCommands": true,
                "commands": [
                    "cd storefront && npm run dev"
                ]
            },
            {
                "name": "3. Medusa Backend",
                "color": "terminal.ansiGreen",
                "icon": "server",
                "autoExecuteCommands": true,
                "commands": [
                    "cd backend && npx medusa develop"
                ]
            }     
        ]
    }
}